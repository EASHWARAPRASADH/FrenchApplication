DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # =========================================================================
    # CYBERSECURITY & PROPRIETARY CONTENT THEFT PROTECTION
    # =========================================================================

    # A. Block all hidden files and directories (.env, .git, .htaccess, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    # B. Block direct access to logs, framework data, backups, and source code
    RewriteRule ^storage/logs/ - [F,L]
    RewriteRule ^storage/framework/ - [F,L]
    RewriteRule ^storage_backup/ - [F,L]
    RewriteRule \.(log|sql|bak|backup|env|sh|ini)$ - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]

    # C. Block automated scraping bots, CLI downloaders, and vulnerability crawlers from harvesting storage & media
    RewriteCond %{REQUEST_URI} !\.(docx?|pptx?|xlsx?)$ [NC]
    RewriteCond %{HTTP_USER_AGENT} (curl|wget|python-requests|python-urllib|scrapy|aiohttp|go-http-client|httpie|libwww-perl|sqlmap|nikto|wpscan|HTTrack|teleport|masscan|zgrab) [NC]
    RewriteCond %{REQUEST_URI} ^/(storage/|files/|file/) [NC]
    RewriteRule ^ - [F,L]

    # D. Anti-Hotlinking: Prevent external websites from leeching proprietary audio and lesson documents
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*tslanguageschool\.com [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*(officeapps\.live\.com|office\.com|office\.net|live\.com|microsoft\.com) [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*(google\.com|googleusercontent\.com) [NC]
    RewriteCond %{REQUEST_URI} \.(mp3|wav|ogg|m4a|pdf|doc|docx|ppt|pptx|xls|xlsx)$ [NC]
    RewriteRule ^ - [F,L]

    # E. Force sensitive media storage (uploads, lesson content, courses) through Laravel for authentication
    RewriteCond %{REQUEST_URI} ^/storage/(uploads|lesson-content|courses|app)/ [NC]
    RewriteRule ^ index.php [L]

    # 3. Prioritize Real Files and Folders (Static Assets: css, js, fonts, public icons)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Route Backend & Dynamic application paths to Laravel (index.php)
    RewriteCond %{REQUEST_URI} ^/(login|register|auth|forgot-password|reset-password|join-now|dashboard|student|teacher|admin|api|logout|password|verify|email|confirm-password|profile|storage|file|files|courses|course|about|testimonials|test|lesson|exams|media-library|certification|membership|contact) [NC]
    RewriteRule ^ index.php [L]

    # 5. Route Everything else to React (index.html)
    RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# File Upload Limits
php_value upload_max_filesize 100M
php_value post_max_size 100M
php_value max_execution_time 600
php_value max_input_time 600
php_value memory_limit 512M

<IfModule mod_litespeed>
    LimitRequestBody 104857600
</IfModule>
